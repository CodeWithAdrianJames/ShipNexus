# Server-only API base URL used by Server Components.
API_URL=http://localhost:3000

# Browser-exposed API base URL used by Client Components.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-only database connection used by the web application.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/shipnexus_db

# Browser-exposed key sent by the deployment trigger client.
NEXT_PUBLIC_INTERNAL_API_KEY=your-internal-api-key-here
