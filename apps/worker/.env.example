DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/shipnexus_db
REDIS_URL=redis://:PASSWORD@localhost:6380

AWS_ENDPOINT_URL=http://localhost:4567
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

SQS_QUEUE_NAME=shipnexus-deployments.fifo
SQS_VISIBILITY_TIMEOUT=900
SQS_WAIT_TIME_SECONDS=20

# Fallback cluster for environment values outside development, staging, and production.
ECS_CLUSTER_NAME=your-default-ecs-cluster
ECS_POLL_INTERVAL_MS=15000
ECS_POLL_MAX_ATTEMPTS=40
ECS_SKIP_STABILITY_POLL=false
ECS_DRY_RUN=false
